{
  "name": "s3uitool",
  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "overrides": {
    "@babel/core": "^8.0.1",
    "dompurify": "^3.4.13"
  },
  "private": true,
  "scripts": {
    "dev:local": "cross-env AWS_S3_ENDPOINT_URL=http://localhost:9000 AWS_SQS_ENDPOINT_URL=http://localhost:9324 AWS_DEFAULT_REGION=us-east-1 AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_SESSION_TOKEN= bun run dev",
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:app\" --names \"API,APP\" --prefix-colors \"blue,green\"",
    "dev:app": "bun run --filter app dev",
    "dev:api": "bun run --filter api dev",
    "build": "bun run --filter app build",
    "fix": "concurrently \"bun run fix:app\" \"bun run fix:api\" --names \"APP,API\" --prefix-colors \"green,blue\"",
    "fix:app": "bun run --filter app fix",
    "fix:api": "bun run --filter api fix",
    "lint": "bun run --filter app lint",
    "lint:api": "bun run --filter api lint",
    "check": "concurrently \"bun run check:app\" \"bun run check:api\" --names \"APP,API\" --prefix-colors \"green,blue\"",
    "check:app": "bun run --filter app check",
    "check:api": "bun run --filter api check",
    "typecheck": "concurrently \"bun run typecheck:app\" \"bun run typecheck:api\" --names \"APP,API\" --prefix-colors \"green,blue\"",
    "typecheck:app": "bun run --filter app typecheck",
    "typecheck:api": "bun run --filter api typecheck",
    "test:app": "bun run --filter app test",
    "test:e2e": "bun run --filter e2e test",
    "test:e2e:ui": "bun run --filter e2e test --ui",
    "test:api": "bun run --filter api test",
    "seed": "bun run --filter api seed",
    "prepare": "husky"
  },
  "workspaces": [
    "app",
    "api",
    "e2e"
  ]
}
