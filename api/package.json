    "@aws-sdk/lib-storage": "3.1105.0",
    "@smithy/shared-ini-file-loader": "4.7.0",
    "fflate": "0.8.3",
    "hono": "4.13.0",
    "mime-types": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/mime-types": "^3.0.1"
