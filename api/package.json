{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/server.js",
    "seed": "bun --env-file=../.env scripts/seed-data.ts",
    "test": "bun test",
    "lint": "biome lint .",
    "fix": "biome check --write .",
    "check": "biome ci .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@aws-sdk/client-sqs": "3.1103.0",
    "@aws-sdk/lib-storage": "3.1103.0",
    "fflate": "0.8.3",
    "hono": "4.13.0",
    "mime-types": "3.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@types/mime-types": "^3.0.1",
    "typescript": "^7.0.2"
  }
}
