{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --bytecode --minify --sourcemap --outfile=dist/server",
    "seed": "bun --env-file=../.env scripts/seed-data.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/client-sqs": "3.1141.0",
    "@aws-sdk/client-sts": "3.1141.0",
    "@aws-sdk/credential-providers": "3.1141.0",
    "@aws-sdk/lib-storage": "3.1141.0",
    "@smithy/core": "^3.35.0",
    "fflate": "0.8.3",
    "hono": "4.13.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
