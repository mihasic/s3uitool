{
  "app/**/*.{js,ts,tsx}": [
    "cd app && bunx @biomejs/biome check --write --no-errors-on-unmatched"
  ],
  "app/**/*.{css,json}": [
    "cd app && bunx @biomejs/biome check --write --no-errors-on-unmatched"
  ],
  "api/**/*.py": [
    "uv run --project api ruff check --fix",
    "uv run --project api ruff format"
  ]
}
