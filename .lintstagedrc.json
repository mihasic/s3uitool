{
  "app/**/*.{js,ts,tsx}": [
    "bunx biome check --config-path app/biome.json --write --no-errors-on-unmatched"
  ],
  "app/**/*.{css,json}": [
    "bunx biome check --config-path app/biome.json --write --no-errors-on-unmatched"
  ],
  "api/**/*.py": [
    "uv run --project api ruff check --fix",
    "uv run --project api ruff format"
  ]
}
