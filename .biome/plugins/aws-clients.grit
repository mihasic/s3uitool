language js

`new $client($_)` where {
  $client <: or {
    `S3Client`,
    `SQSClient`,
    `STSClient`
  },
  register_diagnostic(span=$client, message="Construct AWS clients only in api/src/aws.ts, via getS3Client()/getSqsClient()/getStsClient(): they resolve per-profile credentials and endpoints and force path-style S3.", severity="error")
}
